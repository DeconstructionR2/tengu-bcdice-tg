# ============================================================
# tengu-bcdice-tg 环境变量（脚手架）
# 填写纪律：token 值由用户本人填写，agent 不代写。
# 本文件入库；.env 不入库（.gitignore 已排除）。
# 部署：.env 放数据卷 /opt/<project>/data（计划 §9 token 管理）
# ============================================================

# --- Telegram Bot Tokens（@BotFather 创建，T0.2）---
# 正式 bot
TELEGRAM_BOT_TOKEN=
# 测试 bot（集成测试用第二 bot 账号，计划 §0.2.4）
TELEGRAM_BOT_TOKEN_TEST=

# --- 运行分支 ---
# 不设/其它值 = 用 TELEGRAM_BOT_TOKEN（正式）；=test = 用 TELEGRAM_BOT_TOKEN_TEST
# 跑测试 bot 实例：TENGU_ENV=test bundle exec ruby bot/main.rb
# （2026-10-12 验收期补登：此键原先只在 bot/config.rb 报错文案里出现）
#TENGU_ENV=test

# --- 功能开关 ---
# 掷骰结果是否写运营日志（0=关 / 1=开）
LOG_ROLLS=0
# 跑团 log 录制功能主开关（R8 隐私边界：显式 /log new 才开录）
LOGGING_ENABLED=1

# --- 路径 ---
# 容器内默认 /app/data/tengu.db；本机开发建议 ./data/tengu.db
DB_PATH=/app/data/tengu.db
